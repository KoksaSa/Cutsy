{
  "name": "cutsy-cad-pro",
  "version": "2.0.0",
  "description": "2D CAD приложение для раскладки деталей",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.cutsy.cad",
    "productName": "Cutsy CAD PRO",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}